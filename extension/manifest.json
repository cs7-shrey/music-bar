{
    "manifest_version": 3,
    "name": "Music Bar",
    "version": "1.0.1",
    "description": "Lets the Music Bar app control YouTube Music in this browser.",
    "key": "",
    "minimum_chrome_version": "138",
    "background": { "service_worker": "background.js" },
    "permissions": ["nativeMessaging", "userScripts", "alarms"],
    "host_permissions": ["https://music.youtube.com/*"],
    "icons": { "128": "icon-128.png" }
}

{
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./src/renderer/*"]
        }
    },
    "include": ["src/renderer/**/*", "src/shared/**/*"]
}
